PORT=8081
DATABASE_URL=jdbc:postgresql://postgres:5432/iam_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
# Required, at least 32 bytes. Generate one: openssl rand -base64 48
JWT_SECRET=
INTERNAL_SERVICE_SECRET=local-internal-service-secret-change-me
JWT_ISSUER=jira-like-iam
JWT_AUDIENCE=jira-like-api
JWT_ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30
