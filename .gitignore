# Keep test source and project definitions under version control; generated test
# outputs remain covered by the rules above.
!tests/
!tests/**/*.cs
!tests/**/*.csproj
!apps/api-gateway-nest/src/**/*.spec.ts
!apps/issue-service-nest/src/**/*.spec.ts
!apps/web-client/src/**/*.test.ts
!apps/web-client/src/**/*.test.tsx
!apps/web-client/src/test/
!apps/web-client/src/test/**/*.ts

# Keep Markdown focused on canonical docs and agent guidance.
*.md
!/README.md
!docs/
!docs/**
!AGENTS.md
!CLAUDE.md
