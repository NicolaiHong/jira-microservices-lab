  <diagram id="issue-event-flow" name="02 - Issue Event Flow">
    <mxGraphModel dx="1700" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="p0"/>
        <mxCell id="p1" parent="p0"/>

        <mxCell id="p-title" value="Issue Events → Notifications (Transactional Outbox + Kafka)" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="p1">
          <mxGeometry x="60" y="30" width="1800" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p-subtitle" value="Nét xanh: HTTP đồng bộ · Nét cam: Kafka · Nét tím: ghi DB/Redis · Nét đỏ đứt: nhánh lỗi · Event types: issue.created · issue.updated · issue.assigned · issue.transitioned · issue.commented" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#4B5563;" vertex="1" parent="p1">
          <mxGeometry x="60" y="70" width="1800" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="p-gateway" value="&lt;b&gt;1 · API Gateway&lt;/b&gt;&lt;br&gt;Issue command /api/...&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;JWT · correlation ID&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E3A8A;spacing=12;" vertex="1" parent="p1">
          <mxGeometry x="60" y="170" width="250" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="p-issue" value="&lt;b&gt;2 · Issue Service use case&lt;/b&gt;&lt;br&gt;Check project access (sync)&lt;br&gt;Enforce domain invariants&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Project down → 503&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0EA5E9;strokeWidth=2;fontColor=#0C4A6E;spacing=12;" vertex="1" parent="p1">
          <mxGeometry x="400" y="170" width="280" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="p-issue-db" value="&lt;b&gt;3 · issue_db — 1 transaction&lt;/b&gt;&lt;br&gt;issue / comment&lt;br&gt;issue_history&lt;br&gt;outbox_events (pending)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#F3E8FF;strokeColor=#8B5CF6;fontColor=#4C1D95;" vertex="1" parent="p1">
          <mxGeometry x="770" y="160" width="280" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="p-outbox" value="&lt;b&gt;4 · Outbox publisher&lt;/b&gt;&lt;br&gt;poll 2s · batch 50&lt;br&gt;message key = aggregateId&lt;br&gt;ack → mark published&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;broker lỗi → giữ pending, retry&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0EA5E9;strokeWidth=2;fontColor=#0C4A6E;spacing=12;" vertex="1" parent="p1">
          <mxGeometry x="1140" y="170" width="280" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="p-redpanda" value="&lt;b&gt;5 · Redpanda / Kafka&lt;/b&gt;&lt;br&gt;issue.events.v1&lt;br&gt;&lt;font color=&quot;#9A3412&quot;&gt;envelope schemaVersion 1&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontColor=#9A3412;spacing=10;" vertex="1" parent="p1">
          <mxGeometry x="1510" y="170" width="300" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="p-project" value="&lt;b&gt;Project Service&lt;/b&gt;&lt;br&gt;GET /internal/projects/{id}/access-context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0EA5E9;strokeWidth=2;fontColor=#0C4A6E;spacing=10;" vertex="1" parent="p1">
          <mxGeometry x="770" y="400" width="280" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="p-consumer" value="&lt;b&gt;6 · Notification consumer&lt;/b&gt;&lt;br&gt;group notification-service-v1&lt;br&gt;validate envelope&lt;br&gt;bỏ actor · dedupe recipientUserIds&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;xử lý tuần tự từng record&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0EA5E9;strokeWidth=2;fontColor=#0C4A6E;spacing=12;" vertex="1" parent="p1">
          <mxGeometry x="1510" y="560" width="300" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="p-recheck" value="&lt;b&gt;7 · Recheck quyền từng recipient&lt;/b&gt;&lt;br&gt;200 → eligible&lt;br&gt;404 PROJECT_NOT_FOUND → skip&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;lỗi khác → retry (tối đa 5 lần)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0EA5E9;strokeWidth=2;fontColor=#0C4A6E;spacing=12;" vertex="1" parent="p1">
          <mxGeometry x="1140" y="560" width="280" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="p-redis" value="&lt;b&gt;8 · Redis pipeline&lt;/b&gt;&lt;br&gt;notification:{userId}:{id}&lt;br&gt;notifications:user:{userId}&lt;br&gt;&lt;font color=&quot;#065F46&quot;&gt;id = sha256(eventId:userId) → idempotent&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ECFDF5;strokeColor=#10B981;fontColor=#065F46;fontSize=11;" vertex="1" parent="p1">
          <mxGeometry x="770" y="550" width="280" height="170" as="geometry"/>
        </mxCell>
